# Ruta de SQLite para desarrollo local. Orbis lee esta variable del entorno.
ORBIS_DATABASE_URL=sqlite:///./orbis.db
# Proveedor de precios solo para valoración PAPER (kraken|coingecko|manual|static).
# Los públicos (kraken, coingecko) son de solo lectura, sin claves, y nunca ejecutan.
ORBIS_PRICE_PROVIDER=kraken
# Rutas locales independientes. La bóveda REAL se crea cifrada al definir
# una contraseña; LAB sólo debe contener datos públicos y simulaciones.
ORBIS_REAL_VAULT_PATH=./orbis-real.vault
ORBIS_LAB_PATH=./orbis-lab.db
# Reglas y simulaciones DCA ficticias, separadas de LAB y de la bóveda REAL.
ORBIS_AUTOMATION_PATH=./orbis-automation.db
# Libro PAPER manual de perpetuos GRVT; capital ficticio y sin órdenes reales.
ORBIS_PAPER_PERP_PATH=./orbis-paper-perp.db
# Seguimiento de estrategias LONG MEXC Spot con capital ficticio por sesión.
ORBIS_SPOT_STRATEGY_PATH=./orbis-spot-strategy-paper.db
